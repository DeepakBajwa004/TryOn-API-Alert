# Copy to .env for local runs. On Render, set these in Environment tab instead.
# Never commit the real .env file.

# Telegram user-account credentials (my.telegram.org -> API development tools).
# Telethon needs these even when logging in with a session string.
TG_API_ID=
TG_API_HASH=
TG_SESSION_STRING=

# Who gets the call/message: @username (without @). Must be a DIFFERENT account than the session owner.
TG_TARGET=

# Secret that backend must send in the X-API-Key header (min 32 chars).
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
ALERT_API_KEY=

# Optional tuning
DEFAULT_RING_SECONDS=30
CALL_COOLDOWN_SECONDS=60
DEDUP_WINDOW_SECONDS=30
MAX_INFLIGHT=20
LOG_LEVEL=INFO
